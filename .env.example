# ─────────────────────────────────────────────────────────────
#  SERVER
# ─────────────────────────────────────────────────────────────
PORT=3000
# Public HTTPS base URL of this app (ngrok / cloud URL).
# Twilio must be able to reach it: <PUBLIC_URL>/webhook/twilio
PUBLIC_URL=https://your-tunnel.ngrok-free.app

# Username/password for the dashboard (basic auth). Leave blank to disable.
DASHBOARD_USER=
DASHBOARD_PASS=

# ─────────────────────────────────────────────────────────────
#  TWILIO  (https://console.twilio.com)
# ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Your WhatsApp sender, E.164 with the whatsapp: prefix.
# Sandbox default is whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: use a Messaging Service instead of a single sender.
TWILIO_MESSAGING_SERVICE_SID=
# Verify that incoming webhooks are really from Twilio (recommended in prod).
TWILIO_VALIDATE_SIGNATURE=false

# ─────────────────────────────────────────────────────────────
#  AZURE OPENAI  (https://portal.azure.com -> your OpenAI resource)
# ─────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# ─────────────────────────────────────────────────────────────
#  DATABASE
# ─────────────────────────────────────────────────────────────
# Leave blank for local SQLite (data/app.db) — zero setup.
# Set to a Postgres URL for Vercel/production (Neon, Supabase, Vercel Postgres).
# Use the provider's POOLED connection string.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
#  BEHAVIOUR
# ─────────────────────────────────────────────────────────────
# Company knowledge file used to answer user queries.
COMPANY_CONTEXT_FILE=./context/company.md
# Auto-reply to every inbound message (can also be toggled in the UI).
AUTO_REPLY_DEFAULT=true
# Simulate Twilio/Azure calls instead of making them (auto-on when keys are missing).
DRY_RUN=
