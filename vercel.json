{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["web/**", "context/**"], "maxDuration": 30 }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.js" }]
}
